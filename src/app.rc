#pragma code_page(65001)

#include "resource.h"
#include <windows.h>
#include <winver.h>
#include "Version.h"

IDI_EVERON ICON "Everon.ico"

IDD_SETTINGS DIALOGEX 0, 0, 280, 268
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Everon Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Language:", IDC_LANGUAGE_LABEL, 10, 12, 50, 8
    COMBOBOX        IDC_LANGUAGE_COMBO, 70, 10, 200, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "General", IDC_GENERAL_GROUP, 10, 30, 260, 70
    LTEXT           "Period:", IDC_PERIOD_LABEL, 20, 45, 40, 8
    EDITTEXT        IDC_PERIOD_EDIT, 70, 43, 60, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "seconds", IDC_PERIOD_SECONDS_LABEL, 135, 45, 50, 8
    LTEXT           "Key press:", IDC_KEYPRESS_LABEL, 20, 65, 45, 8
    COMBOBOX        IDC_KEY_COMBO, 75, 63, 130, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Keep display on", IDC_KEEPDISPLAY_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 83, 115, 10
    CONTROL         "Start with Windows", IDC_AUTOSTART_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 145, 83, 115, 10
    CONTROL         "Show notifications on Enable/Disable", IDC_NOTIFY_TOGGLE_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 93, 235, 10
    GROUPBOX        "Timer", IDC_TIMER_GROUP, 10, 105, 260, 65
    CONTROL         "Indefinitely", IDC_TIMER_INDEFINITE, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 20, 120, 70, 10
    CONTROL         "For duration:", IDC_TIMER_DURATION, "Button", BS_AUTORADIOBUTTON, 20, 135, 65, 10
    EDITTEXT        IDC_TIMER_DURATION_EDIT, 95, 133, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "minutes (5-1440)", IDC_TIMER_DURATION_LABEL, 140, 135, 100, 8
    CONTROL         "Until time:", IDC_TIMER_UNTIL, "Button", BS_AUTORADIOBUTTON, 20, 150, 65, 10
    CONTROL         "", IDC_TIMER_UNTIL_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | WS_TABSTOP, 95, 148, 90, 14
    GROUPBOX        "Hotkeys", IDC_HOTKEYS_GROUP, 10, 175, 260, 50
    CONTROL         "Enable global hotkey", IDC_HOTKEY_ENABLE_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 190, 130, 10
    LTEXT           "Toggle hotkey:", IDC_HOTKEY_LABEL, 20, 208, 55, 8
    COMBOBOX        IDC_HOTKEY_COMBO, 80, 206, 180, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 105, 238, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 160, 238, 50, 14
END

